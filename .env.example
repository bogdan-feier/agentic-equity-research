# Create a copy of this file, rename it to .env and add your own API keys below.

# --- Required ---

# Get a Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get a Tavily API key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# --- Optional ---

# The FastAPI backend URL
# - If running via Docker Compose, LEAVE THIS BLANK (defaults to http://backend:8000/research)
# - If running locally without Docker, uncomment and use the localhost address:
# API_URL=http://127.0.0.1:8000/research